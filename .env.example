# Core
APP_NAME=Marketing Telegram Bot
ENVIRONMENT=local
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=
SECRET_KEY=change-this-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
RUN_WORKER_IN_WEB=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_SECRET=change-this-webhook-secret
TELEGRAM_ALLOWED_USER_IDS=

# Obsidian
OBSIDIAN_VAULT_PATH=C:\Obsidian\MarketingVault
KNOWLEDGE_INDEX_PATH=./data/knowledge_index.json

# AI provider order: gemini,groq,openrouter,local
AI_PROVIDER_ORDER=gemini,groq,openrouter,local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
AI_REQUEST_TIMEOUT_SECONDS=90

# Images
POLLINATIONS_ENABLED=false
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# Files
REPORTS_DIR=./reports
LOGS_DIR=./logs
MAX_KNOWLEDGE_SNIPPETS=10

# AI memory in Obsidian
AI_MEMORY_ENABLED=true
AI_MEMORY_DIR=06_AI_Memory
AI_MEMORY_MIN_IMPORTANCE=2
AI_MEMORY_AUTO_REINDEX=true

# Branding
BRAND_PRIMARY_COLOR=#0f766e
BRAND_ACCENT_COLOR=#f59e0b
BRAND_NAME=Marketing Bot
